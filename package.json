{
  "name": "lawware-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-local-db.mjs",
    "test:vertical:draft": "node scripts/test-local-db.mjs --draft",
    "test:provision": "node scripts/test-local-provision.mjs",
    "test:smoke": "node scripts/smoke-server.mjs"
  },
  "dependencies": {
    "@auth0/auth0-express-api": "1.0.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "jose": "6.2.17",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
